{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-app",
  "version": "0.0.0",
  "identifier": "com.acehinnnqru.dsh-app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "shell",
        "title": "DeepSeek Harness",
        "width": 620,
        "height": 460,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "gen/seed-runtime": "runtimes"
    }
  }
}
