{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-app",
  "version": "0.0.0",
  "identifier": "com.acehinnnqru.dsh-app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "shell",
        "title": "DeepSeek Harness",
        "width": 640,
        "height": 580,
        "minWidth": 520,
        "minHeight": 440,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.icns"
    ]
  }
}
